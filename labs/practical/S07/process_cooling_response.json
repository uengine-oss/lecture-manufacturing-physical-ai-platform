{
  "def_id": "cooling_response",
  "name": "냉각 이상 대응",
  "version": 1,
  "description": "접수 → 근거 확인·제안 → 사람 승인 → 조치 → 재점검 (교육용 템플릿)",
  "instance_key": "event_id",
  "defaults": {"window_index": 0},
  "activities": [
    {"id": "intake", "name": "사건 접수", "type": "form", "fields": [
      {"name": "event_id", "label": "사건 ID", "type": "text", "required": true},
      {"name": "asset_id", "label": "설비 ID", "type": "text", "required": true},
      {"name": "run_id", "label": "실행 ID", "type": "text", "required": true},
      {"name": "event_type", "label": "사건 유형", "type": "text", "required": true}]},
    {"id": "bind", "name": "사건-업무 대응 기록", "type": "http", "url": "${HYDOPS_API}/api/system/events/${event_id}/process-ref",
     "body": {"instance_id": "${instance_id}", "def_id": "${def_id}", "key": "${instance_key}"}, "outputs": {"bound": "response.bound"}},
    {"id": "propose", "name": "근거 확인·조치 제안", "type": "agent", "agent_id": "ops-agent",
     "instruction": "사건 ${event_id} 을 처리하라.\n- asset_id: ${asset_id}\n- event_type: ${event_type}\n- run_id: ${run_id}\nSkill 의 판단 순서대로 도구를 호출하고 결과 형식으로 답하라.",
     "outputs": {"decision": "result.proposal.decision", "action_id": "result.proposal.action_id", "proposed_value": "result.proposal.value", "citations": "result.proposal.citations", "rationale": "result.proposal.rationale"}},
    {"id": "record_evidence", "name": "근거 검증·기록", "type": "http", "url": "${HYDOPS_API}/api/system/events/${event_id}/evidence",
     "body": "${agent_result}", "outputs": {"event_status": "response.status", "citation_problems": "response.citation_problems"}},
    {"id": "approve", "name": "조치 승인", "type": "human", "role": "설비 담당자", "fields": [
      {"name": "event_id", "label": "사건 ID", "type": "text", "default": "${event_id}"},
      {"name": "asset_id", "label": "설비 ID", "type": "text", "readonly": true, "default": "${asset_id}"},
      {"name": "action_id", "label": "제안 조치", "type": "text", "readonly": true, "default": "${action_id}"},
      {"name": "proposed_value", "label": "제안값", "type": "number", "readonly": true, "default": "${approved_value}"},
      {"name": "citations", "label": "근거 참조", "type": "citations", "default": "${rationale}"},
      {"name": "rationale", "label": "제안 이유", "type": "textarea", "readonly": true, "default": "${rationale}"},
      {"name": "decision", "label": "결정", "type": "select", "options": ["APPROVED", "REJECTED"], "required": true},
      {"name": "approved_value", "label": "승인값", "type": "number", "default": "${proposed_value}"},
      {"name": "approver", "label": "승인자", "type": "text", "required": true},
      {"name": "comment", "label": "의견", "type": "textarea"}]},
    {"id": "record_decision", "name": "승인 기록", "type": "http", "url": "${HYDOPS_API}/api/system/events/${event_id}/decision",
     "body": {"approver": "${approver}", "decision": "${decision}", "value": "${approved_value}", "comment": "${comment}"},
     "outputs": {"decision_ok": "response.ok", "approval_id": "response.approval.approval_id", "decision_error": "response.error"}},
    {"id": "act", "name": "승인 조치 실행", "type": "tool", "server": "hydops", "tool": "execute_sim_action",
     "args": {"event_id": "${event_id}", "action_id": "${action_id}", "value": "${proposed_value}", "approved": true},
     "outputs": {"act_ok": "result.ok", "action_log_id": "result.action_log.action_log_id", "refused": "result.refused"}},
    {"id": "recheck", "name": "조치 후 재점검", "type": "tool", "server": "hydops", "tool": "verify_recovery",
     "args": {"event_id": "${event_id}", "action_log_id": "${action_log_id}", "window_index": "${window_index}"},
     "retry_until": {"path": "result.final", "equals": true, "interval_s": 2, "update_vars": {"window_index": "result.next_window_index"}},
     "outputs": {"outcome": "result.outcome"}},
    {"id": "end_closed", "name": "종결 (재측정 회복)", "type": "end", "label": "종결", "result": "${outcome}"},
    {"id": "end_escalated", "name": "담당자 이관", "type": "end", "label": "이관", "result": "${outcome}"},
    {"id": "end_verify_hold", "name": "재측정 보류", "type": "end", "label": "재측정 보류", "result": "${outcome}"},
    {"id": "end_rejected", "name": "미실행 종료", "type": "end", "label": "승인 거부", "result": "${decision}"},
    {"id": "end_hold", "name": "보류·센서 점검", "type": "end", "label": "보류", "result": "${event_status}"}
  ],
  "transitions": [
    {"from": "intake", "to": "bind"},
    {"from": "bind", "to": "propose"},
    {"from": "propose", "to": "record_evidence"},
    {"from": "record_evidence", "to": "approve", "when": {"var": "event_status", "op": "==", "value": "PENDING_APPROVAL"}},
    {"from": "record_evidence", "to": "end_hold"},
    {"from": "approve", "to": "record_decision"},
    {"from": "record_decision", "to": "act", "when": {"all": [{"var": "decision", "op": "==", "value": "APPROVED"}, {"var": "decision_ok", "op": "truthy"}]}},
    {"from": "record_decision", "to": "end_rejected"},
    {"from": "act", "to": "recheck", "when": {"var": "act_ok", "op": "truthy"}},
    {"from": "act", "to": "end_escalated"},
    {"from": "recheck", "to": "end_closed", "when": {"var": "outcome", "op": "==", "value": "RECOVERED"}},
    {"from": "recheck", "to": "end_verify_hold", "when": {"var": "outcome", "op": "==", "value": "INSUFFICIENT_DATA"}},
    {"from": "recheck", "to": "end_escalated"}
  ]
}
